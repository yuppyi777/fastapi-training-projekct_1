# Application
APP_NAME=FastAPI Demo App
APP_VERSION=1.0.0
DEBUG=True

# Database
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=app_db
POSTGRES_TEST_DB=test_db
DATABASE_URL=postgresql+asyncpg://admin:password@db:5432/app_db
TEST_DATABASE_URL=postgresql+asyncpg://admin:password@test_db:5432/test_db

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
